# Browser-visible URL of the Socket.IO signaling service.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# Comma-separated WebRTC ICE server URLs.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Signaling service configuration.
SIGNALING_PORT=3001
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_MS=600000
MAX_FILES_PER_TRANSFER=100
MAX_TRANSFER_BYTES=10737418240
