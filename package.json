{
  "name": "KivDrop",
  "version": "0.1.0",
  "private": true,
  "description": "Private, direct browser-to-browser file sharing.",
  "scripts": {
    "dev": "concurrently -k -n web,signal -c cyan,magenta \"npm:dev:web\" \"npm:dev:signal\"",
    "dev:web": "next dev",
    "dev:signal": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:signal": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "next": "^16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
